NODE_ENV=development
PORT=4000
# Локальный запуск: Docker Compose задаёт host=db отдельно.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ijshub

# Тесты сбрасывают только отдельную базу с именем, заканчивающимся на _test.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ijshub_test
JWT_SECRET=replace_with_a_strong_random_secret
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ORIGIN=http://localhost:5173
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# RUN_SCHEDULED_JOBS=false отключает фоновые задачи только в development/test.
# COOKIE_SECURE=true для HTTPS; для локального HTTP оставьте значение по умолчанию.

# Часовой пояс текста напоминаний; даты API сохраняются как абсолютное время.
EVENT_TIME_ZONE=Europe/Moscow
# Для npm run admin:create задайте ADMIN_EMAIL и ADMIN_PASSWORD в окружении.
# Сброс базы: NODE_ENV=development, ALLOW_DB_RESET=1 и RESET_DATABASE_NAME=<точное имя базы>.

# Доверяйте только адресу/сети своего reverse proxy; не ставьте true или 1.
# TRUST_PROXY=172.30.50.0/24
# Необязательный отдельный токен для /metrics и /ops/status при локальном запуске.
# OPS_TOKEN=
# Ограничения соединений и запросов к PostgreSQL:
DB_POOL_MAX=20
DB_ACQUIRE_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=25000
# Почта для восстановления пароля. Без SMTP_URL в разработке письма пишутся в журнал,
# в production восстановление пароля отвечает 503.
# SMTP_URL=smtps://user:password@smtp.yandex.ru:465
# MAIL_FROM="ИЖС платформа <no-reply@example.ru>"
# Production создаётся через ops:configure, см. PRODUCTION.md.
