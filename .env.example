# Только локальная разработка через docker-compose.yml.
# Production: backend/npm run ops:configure -- <домен> <путь независимого хранилища>.
# Подробности: backend/PRODUCTION.md. Этот пример не годится для production.
NODE_ENV=development
PORT=4000
JWT_SECRET=local_development_secret_change_before_use
REFRESH_TOKEN_SECRET=local_refresh_secret_change_before_use
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ORIGIN=http://localhost:5173
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ijshub
DATABASE_URL=postgres://postgres:postgres@db:5432/ijshub
EVENT_TIME_ZONE=Europe/Moscow
# TRUST_PROXY оставьте пустым при прямом подключении к API.
