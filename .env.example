# Общие переменные для docker-compose (VPS/production)
# Скопируйте в .env рядом с docker-compose.yml и замените значения.

# API
PORT=4000
JWT_SECRET=replace_with_a_strong_random_secret

# Разрешённые origin для CORS (через запятую)
# Пример: https://ijshub.ru,https://www.ijshub.ru
CORS_ALLOWED_ORIGINS=https://example.com

# Канонический origin приложения (добавляется в allowlist автоматически)
# Пример: https://ijshub.ru
APP_ORIGIN=https://example.com

# Домен для Caddy (auto HTTPS/Let's Encrypt)
# Пример: ijshub.ru
DOMAIN=example.com

# Cookies
# По умолчанию сервер сам включает Secure только на HTTPS.
# Если вы запускаете прод на обычном HTTP и хотите принудительно отключить Secure-куки:
# COOKIE_SECURE=false
# Для сценария с разными поддоменами фронта/API можно включить:
# CORS_ALLOW_CREDENTIALS=true
# COOKIE_SAME_SITE=none
# COOKIE_DOMAIN=.example.com

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ijshub

# Внутри docker-compose хост БД = db
DATABASE_URL=postgres://postgres:postgres@db:5432/ijshub
